{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Dependency Dashboard issue, monorepo grouping, changelog links. Catalog entries that share a
  // version.ref (kotlin, circuit, ktor, ...) already update together in one PR.
  extends: ["config:recommended"],

  packageRules: [
    {
      description: "settings.gradle.kts lists Maven Central's snapshot repository for trying unreleased builds by hand. Never propose one.",
      matchManagers: ["gradle"],
      allowedVersions: "!/-SNAPSHOT$/",
    },
  ],
}
